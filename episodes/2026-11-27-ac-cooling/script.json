 "en": {
  "title": "How an Air Conditioner Works in 3 Steps",
  "voice": "en-US-AndrewNeural",
  "rate": "+10%",
  "lines": [
   {
    "caption": "You pay for cold air"
   },
   {
    "caption": "but your AC never makes any!"
   },
   {
    "caption": "How?"
   },
   {
    "caption": "Inside it flows a special fluid"
   },
   {
    "caption": "through pipes inside your room"
   },
   {
    "caption": "It evaporates and soaks up heat"
   },
   {
    "caption": "then carries that heat outside"
   },
   {
    "caption": "where the compressor squeezes it hard"
   },
   {
    "caption": "until it's hotter than the street"
   },
   {
    "caption": "so it dumps the heat outdoors"
   },
   {
    "caption": "Then it squeezes through a tiny valve"
   },
   {
    "caption": "its pressure drops, and it turns icy"
   },
   {
    "caption": "and heads back in to repeat"
   },
   {
    "caption": "That's why the outdoor unit blows"
   },
   {
    "caption": "hot air: it's your home's heat!"
   },
   {
    "caption": "Your AC doesn't make cold"
   },
   {
    "caption": "it moves your heat outside!"
   }
  ]
 }
