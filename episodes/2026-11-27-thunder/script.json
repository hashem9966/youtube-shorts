 "en": {
  "title": "How Far Is the Storm? Divide by 3",
  "voice": "en-US-AndrewNeural",
  "rate": "+10%",
  "lines": [
   {
    "caption": "You always see lightning first"
   },
   {
    "caption": "then the thunder rolls in!"
   },
   {
    "caption": "Why?"
   },
   {
    "caption": "Both happen at the same instant"
   },
   {
    "caption": "but they travel to you differently"
   },
   {
    "caption": "Light is way faster than sound"
   },
   {
    "caption": "Light crosses the gap instantly"
   },
   {
    "caption": "Sound just strolls along"
   },
   {
    "caption": "about 1 km every 3 seconds"
   },
   {
    "caption": "so the thunder arrives late"
   },
   {
    "caption": "Here's a handy trick"
   },
   {
    "caption": "Count the seconds after the flash"
   },
   {
    "caption": "divide by three"
   },
   {
    "caption": "and you get the storm's distance"
   },
   {
    "caption": "9 seconds? About 3 km away"
   },
   {
    "caption": "Shorter gap, closer storm"
   },
   {
    "caption": "That's why you see lightning first!"
   }
  ]
 }
