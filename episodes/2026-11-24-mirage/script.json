 "en": {
  "title": "That Puddle on the Road Is the Sky",
  "voice": "en-US-AndrewNeural",
  "rate": "+10%",
  "lines": [
   {
    "caption": "You see water on the road ahead"
   },
   {
    "caption": "but it's never really there"
   },
   {
    "caption": "Why?"
   },
   {
    "caption": "The sun bakes the asphalt"
   },
   {
    "caption": "and the asphalt heats the air above it"
   },
   {
    "caption": "so the air near the ground is hottest"
   },
   {
    "caption": "Light changes speed between hot and cool air"
   },
   {
    "caption": "so it bends instead of going straight"
   },
   {
    "caption": "Sky light dips down… then curves up"
   },
   {
    "caption": "into your eye from below"
   },
   {
    "caption": "Your brain assumes light travels straight"
   },
   {
    "caption": "so it sees the sky on the ground"
   },
   {
    "caption": "and it looks like a puddle"
   },
   {
    "caption": "Drive closer, and it moves away"
   },
   {
    "caption": "because the angle keeps changing"
   },
   {
    "caption": "So what you saw wasn't water"
   },
   {
    "caption": "it was a picture of the sky!"
   }
  ]
 }
