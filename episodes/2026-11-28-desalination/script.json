 "en": {
  "title": "Desalination Explained in 2 Methods",
  "voice": "en-US-AndrewNeural",
  "rate": "+10%",
  "lines": [
   {
    "caption": "You may have drunk seawater today"
   },
   {
    "caption": "without tasting any salt!"
   },
   {
    "caption": "How?"
   },
   {
    "caption": "Saudi Arabia leads the world in desalination"
   },
   {
    "caption": "using two main methods"
   },
   {
    "caption": "Method one: boil the seawater"
   },
   {
    "caption": "Only the water evaporates"
   },
   {
    "caption": "the salt stays at the bottom"
   },
   {
    "caption": "Cool the steam: fresh water!"
   },
   {
    "caption": "Method two: reverse osmosis"
   },
   {
    "caption": "Push seawater with huge pressure"
   },
   {
    "caption": "against a membrane with tiny holes"
   },
   {
    "caption": "Water slips through, salt gets stuck"
   },
   {
    "caption": "It's the most common method today"
   },
   {
    "caption": "because it saves a lot of energy"
   },
   {
    "caption": "So the water in your glass"
   },
   {
    "caption": "may once have been in the sea!"
   }
  ]
 }
