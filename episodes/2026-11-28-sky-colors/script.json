 "en": {
  "title": "Blue Sky, Red Sunset: 1 Simple Reason",
  "voice": "en-US-AndrewNeural",
  "rate": "+10%",
  "lines": [
   {
    "caption": "The sky turns red at sunset"
   },
   {
    "caption": "for one simple reason"
   },
   {
    "caption": "What is it?"
   },
   {
    "caption": "Sunlight looks white"
   },
   {
    "caption": "but it's a mix of all colors"
   },
   {
    "caption": "from red all the way to blue"
   },
   {
    "caption": "When it enters the air"
   },
   {
    "caption": "the colors hit tiny air molecules"
   },
   {
    "caption": "Blue scatters in every direction"
   },
   {
    "caption": "so the sky looks blue"
   },
   {
    "caption": "But at sunset"
   },
   {
    "caption": "light crosses far more air"
   },
   {
    "caption": "Blue scatters away before reaching you"
   },
   {
    "caption": "only red and orange remain"
   },
   {
    "caption": "painting the sky red"
   },
   {
    "caption": "The same air makes both colors"
   },
   {
    "caption": "blue at noon, red at sunset!"
   }
  ]
 }
