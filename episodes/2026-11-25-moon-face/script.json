 "en": {
  "title": "The Moon Does Spin. So Why Only 1 Side?",
  "voice": "en-US-AndrewNeural",
  "rate": "+10%",
  "lines": [
   {
    "caption": "There's a side of the Moon"
   },
   {
    "caption": "you will never see from Earth!"
   },
   {
    "caption": "Why?"
   },
   {
    "caption": "You might think it doesn't spin"
   },
   {
    "caption": "but the Moon really does spin"
   },
   {
    "caption": "once every 27 days or so"
   },
   {
    "caption": "That's exactly the same time"
   },
   {
    "caption": "it takes to circle Earth"
   },
   {
    "caption": "So with every step forward"
   },
   {
    "caption": "it turns a little toward us"
   },
   {
    "caption": "The cause? Earth's gravity"
   },
   {
    "caption": "tugged on it for millions of years"
   },
   {
    "caption": "until its spin slowed and locked"
   },
   {
    "caption": "And the far side isn't dark"
   },
   {
    "caption": "the Sun lights it up too"
   },
   {
    "caption": "It spins, yet always faces us"
   },
   {
    "caption": "so you'll never see its other side!"
   }
  ]
 }
