 "en": {
  "title": "The 9% Reason Ice Floats on Water",
  "voice": "en-US-AndrewNeural",
  "rate": "+10%",
  "lines": [
   {
    "caption": "Your ice cube never sinks"
   },
   {
    "caption": "even though it's solid water!"
   },
   {
    "caption": "Why?"
   },
   {
    "caption": "When most things freeze"
   },
   {
    "caption": "their molecules pack tight, and sink"
   },
   {
    "caption": "Water does the opposite"
   },
   {
    "caption": "Liquid water molecules are crowded"
   },
   {
    "caption": "Freezing locks them with hydrogen bonds"
   },
   {
    "caption": "into a six-sided lattice"
   },
   {
    "caption": "full of empty gaps"
   },
   {
    "caption": "So ice grows about 9% bigger"
   },
   {
    "caption": "Same weight, bigger volume"
   },
   {
    "caption": "so it floats on water"
   },
   {
    "caption": "In winter, lakes freeze on top"
   },
   {
    "caption": "and fish live on underneath"
   },
   {
    "caption": "Tiny gaps inside the ice"
   },
   {
    "caption": "are why it never sinks!"
   }
  ]
 }
